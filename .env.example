BOOKFORGE_MODEL_PROVIDER=mock
BOOKFORGE_MOCK_MODEL=deterministic-mock

# To use a host-side subscribed AI tool, set:
# BOOKFORGE_MODEL_PROVIDER=local_agent
# BOOKFORGE_LOCAL_AGENT_NAME=codex-local
# BOOKFORGE_ADAPTER_PRESET=codex
# Supported example presets live in config/adapters/presets.json.

# To use OpenAI-backed generation, set:
# BOOKFORGE_MODEL_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_MODEL=gpt-5.5

# The local web settings page stores non-secret runtime choices here:
# config/runtime.local.json
# Do not put raw API keys, OAuth tokens, cookies, or passwords in that file.
